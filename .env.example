# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DB_HOST=ep-xxxx.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=
DB_SSL=require
DB_URL=postgresql://neondb_owner:password@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── OCR ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# OCR read path: auto (text layer, vision fallback) | text | vision. Restart to apply.
# 'auto' is more accurate on digital PDFs; 'vision' is the old always-rasterise behaviour.
OCR_TO_USE=auto
OPENAI_OCR_MODEL=gpt-4o
# Text-layer adequacy thresholds (see config.py)
OCR_TEXT_MIN_CHARS_PER_PAGE=100
OCR_TEXT_MIN_CHARS_ANY_PAGE=20
SARVAM_API_KEY=
POPPLER_PATH=          # macOS: /opt/homebrew/bin  |  Windows: C:\poppler\bin

# ─── Sandbox.co.in KYB / GST ─────────────────────────────────────────────────
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_BASE_URL=https://api.sandbox.co.in

# ─── Email (SMTP / IMAP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=456
SMTP_USER=
SMTP_PASSWORD=
SMTP_ADMIN_EMAIL=
IMAP_HOST=imap.gmail.com

# ─── Auth ─────────────────────────────────────────────────────────────────────
APPROVAL_SECRET=change-me

# ─── Tally Prime ─────────────────────────────────────────────────────────────
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=

# ─── Tally Sync Settings ──────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
TALLY_PULL_DAYS=30
TALLY_THREAD_POOL=4
DEFAULT_SALES_LEDGER=Sales A/c
DEFAULT_TAX_LEDGER=
DEFAULT_BANK_LEDGER=Cash

# ─── Pipeline Tuning ─────────────────────────────────────────────────────────
API_SYNC_BATCH=50
WEBHOOK_BATCH=50
UPLOAD_BATCH=10
PROMOTION_BATCH=100
APPROVAL_BATCH=50
POLL_INTERVAL_S=5
AUTO_APPROVE_THRESHOLD=50000

# ─── Multi-tenancy ────────────────────────────────────────────────────────────
TENANT_ID=
BACKEND_TENANT_ID=
TENANT_NAME=
TENANT_GSTN=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Also reflected in frontend/.env.production for Vite build
VITE_API_URL=https://onsumm.onrender.com

# Tenants this pipeline instance processes (comma-separated; empty = ALL tenants).
# Was hardcoded in main.py; a new tenant got no background processing until it was
# edited and redeployed. Set per environment.
PIPELINE_TENANT_ID=

# Platform (ops) admin — signs /api/admin/* tokens. MUST be set, MUST differ from
# JWT_SECRET, and MUST differ between dev and prod (they currently share JWT_SECRET,
# so a shared value would make a dev ops token valid against production).
PLATFORM_JWT_SECRET=

# Licensing enforcement: off | log | enforce. Ship 'log' (records would-be denials
# without acting), read the logs, then flip to 'enforce'.
LICENSE_ENFORCEMENT=log

# ── Observability (app/core/observability.py) ────────────────────────────────
# Bearer token a Prometheus scraper must send to read /metrics. Deliberately no
# default: unset means the endpoint answers 503 rather than serving openly, the
# same stance PLATFORM_JWT_SECRET takes. Generate one per environment.
METRICS_TOKEN=

# 'json' emits one JSON object per log line for ingestion; anything else keeps
# the human-readable format. Both carry the request id.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Optional error reporting. Left blank, Sentry is not initialised at all and the
# SDK is not required — it is not in requirements.txt.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
